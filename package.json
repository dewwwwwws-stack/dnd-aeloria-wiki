{
  "name": "atlas-spell-effects",
  "version": "1.5.3",
  "description": "Animated spell areas, walls, light and darkness on Atlas VTT maps, with JB2A's free animations built in. Cast from Atlas statblocks.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=cjs --platform=browser --target=chrome120 --external:obsidian --external:electron --legal-comments=none --outfile=main.js",
    "dev": "npm run build -- --watch",
    "check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "obsidian": "latest",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-obsidianmd": "^0.1.9"
  }
}
